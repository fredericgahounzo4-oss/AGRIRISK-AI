DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clé API Groq — nécessaire pour le Diagnostic IA et l'Assistant IA.
# Créez une clé (gratuite) sur https://console.groq.com/keys
# Une clé Groq ressemble à "gsk_...".
GROQ_API_KEY=
# Optionnel : modèles utilisés (valeurs par défaut ci-dessous). La liste des
# modèles Groq évolue : https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b            # chat (Assistant IA)
# GROQ_VISION_MODEL=qwen/qwen3.8-27b        # analyse d'image (Diagnostic IA)

# Optionnel en local, RECOMMANDÉ en production (Render) : stockage des
# fichiers médias (avatars, photos de diagnostic) sur Cloudinary, pour
# qu'ils survivent aux redéploiements. Sans cette variable, les fichiers
# sont stockés sur le disque local (perdu à chaque déploiement sur Render).
# Format fourni tel quel par le dashboard Cloudinary :
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME


# ---------------------------------------------------------------------
# PAIEMENT FedaPay (Mobile Money : T-Money, Flooz, MTN, Moov... + carte)
# ---------------------------------------------------------------------
# 1. Créez un compte sur https://fedapay.com puis ouvrez le mode "Sandbox" (test).
# 2. Tableau de bord → Paramètres → Clés API : copiez la clé SECRÈTE ("sk_sandbox_...").
# SANS cette clé, en local (DJANGO_DEBUG=true), le site utilise un paiement
# SIMULÉ pour que vous puissiez tester tout le parcours.
FEDAPAY_SECRET_KEY=
# "sandbox" pour tester, "live" quand votre compte est validé (clé "sk_live_...").
FEDAPAY_ENV=sandbox
# Tableau de bord → Webhooks → Créer : URL = https://VOTRE-BACKEND/api/marketplace/webhooks/fedapay
# puis copiez ici la clé secrète du webhook ("wh_...").
FEDAPAY_WEBHOOK_SECRET=

# URL PUBLIQUE de votre frontend (FedaPay y renvoie l'acheteur après paiement).
# Local : http://localhost:5173 — Production : https://votre-site.onrender.com
FRONTEND_URL=http://localhost:5173

# Commission AgriRisk prélevée sur chaque vente (en %, déduite du fournisseur).
MARKETPLACE_COMMISSION_PERCENT=5
# Montant minimum d'une commande (FCFA) et délai avant annulation d'une commande impayée.
MARKETPLACE_MIN_ORDER_AMOUNT=100
ORDER_EXPIRY_MINUTES=30
