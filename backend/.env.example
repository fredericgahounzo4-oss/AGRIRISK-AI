DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Clé API Google Gemini — nécessaire pour le Diagnostic IA et l'Assistant IA.
# Créez une clé (gratuite) sur https://aistudio.google.com/apikey
# Une vraie clé API ressemble à "AIzaSy...". Un jeton OAuth temporaire
# (qui expire après ~1h, souvent de la forme "ya29...." ou "AQ....") ne
# convient PAS ici : la clé doit être stable et durable.
GEMINI_API_KEY=
# Optionnel : change le modèle utilisé (par défaut gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optionnel en local, RECOMMANDÉ en production (Render) : stockage des
# fichiers médias (avatars, photos de diagnostic) sur Cloudinary, pour
# qu'ils survivent aux redéploiements. Sans cette variable, les fichiers
# sont stockés sur le disque local (perdu à chaque déploiement sur Render).
# Format fourni tel quel par le dashboard Cloudinary :
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

